# Charter House — environment template (docs/25_configuration.md §1)
# Copy to `.env` and fill. `.env` is gitignored and is the ONLY home for secrets.
# Secrets never live in config files, the ledger, logs, or code (docs/24_security.md).

# ── Secrets (provider API keys; read by the Router from env at call time) ──────
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Runtime configuration ─────────────────────────────────────────────────────
CHARTERHOUSE_ROOT=K:\the_charter_house
CHARTERHOUSE_DATA_DIR=K:\Data\charter_house
CHARTERHOUSE_VECTORS_DIR=K:\Data\charter_house\vectors
CHARTERHOUSE_PROFILE=free
CHARTERHOUSE_EMBED_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434

# ── Machine-level redirections (set once via `setx`, NOT loaded from this file) ─
# Documented here for reproducibility on a second machine (docs/25 §5).
# Tools and node globals → K:\Tools ; all caches → K:\Data\charter_house\cache ;
# model weights → K:\Models. Nothing on C:. Verify before installing anything.
#   UV_PYTHON_INSTALL_DIR = K:\Tools\uv\python
#   NPM_CONFIG_PREFIX     = K:\Tools\npm
#   UV_CACHE_DIR          = K:\Data\charter_house\cache\uv
#   PIP_CACHE_DIR         = K:\Data\charter_house\cache\pip
#   NPM_CONFIG_CACHE      = K:\Data\charter_house\cache\npm
#   HF_HOME               = K:\Data\charter_house\cache\hf
#   OLLAMA_MODELS         = K:\Models
#   TMP / TEMP            = K:\Data\charter_house\cache\tmp
